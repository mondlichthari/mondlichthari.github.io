<section class="inner"><p class="crumb"><a href="<%= url_for('/') %>">首页</a> / <%= page.title %></p>
<h1 class="display"><%= page.title %></h1>
<% if (page.type === 'categories' || page.type === 'tags') { const items = page.type === 'categories' ? site.categories : site.tags; %>
<div class="directory"><% items.sort('name').each(item => { if (item.length) { %><a class="topic" href="<%= url_for(item.path) %>"><span><%= item.name %></span><small><%= item.length %> 篇</small></a><% } }) %></div>
<% } %><div class="prose"><%- page.content %></div></section>
