<%
const nav = [['首页', '', is_home()], ['归档', config.archive_dir + '/', is_archive()], ['标签', config.tag_dir + '/', is_tag() || page.type === 'tags'], ['分类', config.category_dir + '/', is_category() || page.type === 'categories']];
const contextTitle = page.title || page.tag || page.category || (is_archive() ? '文章归档' : '');
%><!DOCTYPE html>
<html lang="<%= config.language %>" data-mode="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= contextTitle ? contextTitle + ' · ' + config.title : config.title %></title>
  <link rel="canonical" href="<%= full_url_for(page.path.replace(/index\.html$/, '')) %>">
  <%- open_graph({image: theme.banner, description: is_post() ? truncate(strip_html(page.content).trim(), {length: 145}) : config.description}) %>
  <link rel="icon" href="<%= url_for(theme.icon) %>">
  <script>try { if (localStorage.getItem('kanran-mode') === 'light') document.documentElement.dataset.mode = 'light' } catch {}</script>
  <link rel="stylesheet" href="<%= url_for('kanran/site.css') %>">
  <script defer src="<%= url_for('kanran/site.js') %>"></script>
</head>
<body>
  <a class="skip" href="#content">跳至正文</a>
  <header class="top"><div class="shell top-inner">
    <a class="brand" href="<%= url_for('/') %>"><img src="<%= url_for(theme.icon) %>" width="34" height="34" alt=""><span><%= config.title %></span></a>
    <nav aria-label="主导航"><% nav.forEach(([label, path, active]) => { %>
      <a href="<%= url_for('/' + path) %>" <%- active ? 'aria-current="page"' : '' %>><%= label %></a>
    <% }) %></nav>
    <div class="tools">
      <button id="find" type="button" aria-haspopup="dialog"><i class="lens" aria-hidden="true"></i><span>搜索</span></button>
      <button id="mode" type="button" aria-label="切换明暗主题" title="切换明暗主题"><i class="mode-icon" aria-hidden="true"></i></button>
    </div>
  </div></header>
  <main class="shell" id="content"><%- body %></main>
  <footer class="shell foot"><img src="<%= url_for(theme.panorama) %>" alt="街边墙面与手写标语的拼贴" loading="lazy" width="1920" height="299">
    <div><small>© <%= date(Date.now(), 'YYYY') %> <%= config.author %></small><div class="social"><% Object.entries(theme.social).forEach(([name, href]) => { %><a href="<%= href %>"><%= name %></a><% }) %></div></div>
  </footer>
  <dialog id="search" data-index="<%= url_for(config.search.path) %>" aria-labelledby="find-title">
    <div class="dialog-head"><h2 id="find-title">搜索文章</h2><form method="dialog"><button aria-label="关闭搜索">关闭</button></form></div>
    <input id="query" type="search" aria-label="搜索标题、正文或标签" placeholder="输入标题、正文或标签" autofocus>
    <p id="feedback" role="status"></p><ul id="matches"></ul>
  </dialog>
</body>
</html>
